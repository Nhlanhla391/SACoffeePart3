*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#fdf6ec;color:#3b2f2f}
header{background:#3b2f2f;color:white;padding:1rem;text-align:center}
header h1{color:#d4a373}
nav a{color:white;margin:0 10px;text-decoration:none}
nav a:hover{color:#d4a373}
.content{max-width:1000px;margin:2rem auto;padding:1rem;display:grid;grid-template-columns:2fr 1fr;gap:2rem}
.content-single{display:block;max-width:800px}
.content-single h2{color:#6f4e37;margin:1.5rem 0 0.5rem}
aside{background:#fff;padding:1rem;border-radius:8px}
img{max-width:100%;height:auto;border-radius:8px;margin:1rem 0}
button{background:#6f4e37;color:white;border:none;padding:0.7rem 1.2rem;border-radius:6px;cursor:pointer}
button:hover{background:#d4a373;color:#3b2f2f}
footer{text-align:center;background:#3b2f2f;color:white;padding:1rem;margin-top:2rem}
input,select,textarea{width:100%;padding:0.6rem;margin:0.3rem 0 1rem;border:1px solid #ccc;border-radius:6px}
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}
.gallery-grid img{cursor:pointer}
.accordion-content{display:none;padding:1rem;background:#fff8f0}
.accordion-content.active{display:block}
.tab-content{display:none}
.tab-content.active{display:block}
.modal,.lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);align-items:center;justify-content:center;z-index:999}
.modal.active,.lightbox.active{display:flex}
.modal-content{background:white;padding:2rem;border-radius:8px;max-width:500px}
.lightbox img{max-width:90vw;max-height:90vh}
#map{height:300px;width:100%;margin:1rem 0}
.error{color:red}
.success{color:green;font-weight:bold}
@media(max-width:768px){.content{grid-template-columns:1fr}nav a{display:block;margin:5px 0}}